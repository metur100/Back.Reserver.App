{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": ""
  },
  "App": {
    "WebBaseUrl": "https://app.backreserve.example",
    "ProductName": "BackReserve"
  },
  "Jwt": {
    "Issuer": "backreserve",
    "Audience": "backreserve-clients",
    "SigningKey": "",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 30
  },
  "Auth": {
    "RequireConfirmedEmail": true,
    "DefaultTrialPlanCode": "business"
  },
  "Billing": {
    "Provider": "None",
    "AllowDevelopmentPlanChanges": false,
    "TrialDays": 30
  },
  "Email": {
    "Provider": "None",
    "SmtpHost": "",
    "SmtpPort": 587,
    "Security": "StartTls",
    "FromAddress": "no-reply@backreserve.example",
    "FromName": "BackReserve",
    "CaptureInDevMailbox": false
  },
  "Storage": {
    "Provider": "Local",
    "LocalPath": "App_Data/uploads",
    "PublicPathPrefix": "/media/uploads",
    "MaxImageBytes": 5242880
  },
  "Jobs": {
    "Enabled": true,
    "OutboxIntervalSeconds": 10,
    "MaintenanceIntervalSeconds": 300,
    "MaxOutboxAttempts": 8,
    "RetentionEnabled": true,
    "RemindersEnabled": true
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "RateLimiting": {
    "Enabled": true
  },
  "ForwardedHeaders": {
    "Enabled": false,
    "KnownProxies": []
  },
  "Database": {
    "MigrateOnStartup": false
  },
  "Seed": {
    "DemoData": false,
    "DemoPassword": ""
  },
  "PlatformAdmin": {
    "Email": "",
    "Password": ""
  }
}
