# BackReserve — example environment configuration.
# Copy to `.env` for docker compose, or set the same keys as environment variables on your host.
# NEVER commit real values. All values below are placeholders.
# ASP.NET Core maps "__" to ":" (e.g. Jwt__SigningKey -> Jwt:SigningKey).

# ---------- Local docker compose (development only) ----------
MSSQL_SA_PASSWORD=change-me-local-dev-only-1!
MSSQL_PORT=14333
MAILPIT_SMTP_PORT=1026
MAILPIT_UI_PORT=8026

# ---------- API (production / staging) ----------
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://+:8080
ConnectionStrings__Default=Server=tcp:<your-sql-host>,1433;Database=BackReserve;User Id=<app-user>;Password=<secret>;Encrypt=True;TrustServerCertificate=False
# At least 32 random bytes, e.g. `openssl rand -base64 48`
Jwt__SigningKey=<generate-a-long-random-secret>
Jwt__Issuer=backreserve
Jwt__Audience=backreserve-clients
App__WebBaseUrl=https://app.backreserve.example
Cors__AllowedOrigins__0=https://app.backreserve.example

# Email (SMTP). Provider=None means nothing is sent (messages are marked "not sent", never "delivered").
Email__Provider=Smtp
Email__SmtpHost=<smtp-host>
Email__SmtpPort=587
Email__Security=StartTls
Email__Username=<smtp-user>
Email__Password=<smtp-password>
Email__FromAddress=no-reply@backreserve.example
Email__FromName=BackReserve

# Uploaded images (local disk; mount a persistent volume here)
Storage__LocalPath=/data/uploads

# Behind Cloudflare / a reverse proxy
ForwardedHeaders__Enabled=true
# ForwardedHeaders__KnownProxies__0=<proxy-ip>

# Background jobs need an always-on instance (see docs/OPERATIONS.md)
Jobs__Enabled=true

# Billing is not integrated yet. Keep plan changes disabled in production.
Billing__Provider=None
Billing__AllowDevelopmentPlanChanges=false

# Optional bootstrap platform admin (only created if both are set; use a secret store)
PlatformAdmin__Email=
PlatformAdmin__Password=

# ---------- Web app (Vite, build time) ----------
VITE_API_BASE_URL=https://api.backreserve.example

# ---------- Mobile app (Expo, build time) ----------
EXPO_PUBLIC_API_URL=https://api.backreserve.example
